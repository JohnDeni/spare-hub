
ALLOWED_HOSTS=127.0.0.1,localhost,*
SECRET_KEY=django-insecure-CHANGE_THIS_TO_YOUR_SECRET_KEY
DEBUG=True

# Used both by Django (via python-decouple) and by docker-compose.yml
# (Postgres container credentials + variable substitution).
DB_NAME=sparehub
DB_USER=sparehub_user
DB_PASSWORD=postgres
# DB_HOST/DB_PORT below are for running Django directly on the host
# (npm run dev:be) against a locally installed Postgres. When running via
# `docker compose up`, docker-compose.yml overrides these to DB_HOST=db,
# DB_PORT=5432 automatically — no changes needed here for Docker.
DB_HOST=localhost
DB_PORT=5432

# VITE_API_BASE_URL left unset on purpose: the frontend already defaults
# to http://localhost:8000 (see src/features/auth/client.ts).
